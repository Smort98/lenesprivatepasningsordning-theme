{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lene/tidslinje-punkt",
	"title": "Tidslinje-punkt",
	"category": "lene-sektioner",
	"icon": "clock",
	"description": "Ét årstal i tidslinjen.",
	"textdomain": "lene",
	"parent": [ "lene/tidslinje" ],
	"attributes": {
		"aar": { "type": "rich-text", "source": "rich-text", "selector": ".timeline__aar", "default": "" },
		"titel": { "type": "rich-text", "source": "rich-text", "selector": "h3", "default": "" },
		"tekst": { "type": "rich-text", "source": "rich-text", "selector": "p", "default": "" }
	},
	"supports": {
		"html": false,
		"reusable": false,
		"color": false,
		"spacing": false,
		"typography": false
	},
	"editorScript": "file:./index.js"
}
