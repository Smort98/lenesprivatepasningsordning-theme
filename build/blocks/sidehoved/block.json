{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lene/sidehoved",
  "title": "Sidehoved",
  "category": "lene-sektioner",
  "icon": "cover-image",
  "description": "Toppen af en underside: overrubrik, titel og kort tekst på lys grøn baggrund.",
  "keywords": [
    "sidehoved",
    "pagehead",
    "titel"
  ],
  "textdomain": "lene",
  "attributes": {
    "eyebrow": {
      "type": "rich-text",
      "source": "rich-text",
      "selector": ".eyebrow",
      "default": ""
    },
    "titel": {
      "type": "rich-text",
      "source": "rich-text",
      "selector": "h1",
      "default": ""
    },
    "tekst": {
      "type": "rich-text",
      "source": "rich-text",
      "selector": ".lede",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "color": false,
    "spacing": false,
    "typography": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css"
}